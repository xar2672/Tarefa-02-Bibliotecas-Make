\begin_layout Subsection
Causa Raiz da Falha
\end_layout

\begin_layout Standard
Ao inspecionar o arquivo src/calculo.c,
 identificou-se um erro de sinal na implementação da aproximação por diferenças finitas centradas na função calc_derivada_parcial:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
f'(x)\approx\frac{f(x+h)-f(x-h)}{2h}
\]

\end_inset


\end_layout

\begin_layout Standard
No código original,
 a ordem dos termos no numerador estava invertida,
 calculando
\begin_inset Formula $f(x-h)-f(x+h)$
\end_inset

,
 o que resultava no sinal oposto da derivada:
\end_layout

\begin_layout Standard
\begin_inset listings
inline false
status open


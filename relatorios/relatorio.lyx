/* Código INCORRETO em src/calculo.c */
\end_layout

\begin_layout Plain Layout
p[var_index] = ponto[var_index] + h;
\end_layout

\begin_layout Plain Layout
double l_superior = f(p_sup,
 num_vars);
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
p[var_index] = ponto[var_index] - h;
\end_layout

\begin_layout Plain Layout
double l_inferior = f(p_inf,
 num_vars);
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
// return (f(p,num_vars) - f(p,num_vars))/(2*h);
 por conta da alocação dinamica e do free fui obrigado copiar os valores pra f_mais e f_menos
\end_layout

\begin_layout Plain Layout
    free(p);
\end_layout

\begin_layout Plain Layout
return (l_inferior - l_superior)/(2.0 * h);
 // ERRO:
 Ordem invertida!
\end_layout

\end_inset


\end_layout

